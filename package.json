{
  "name": "mitzi-harness",
  "version": "0.1.0",
  "description": "A Claude Code–style agentic coding CLI that runs on any model via OpenRouter",
  "type": "module",
  "bin": {
    "mitzi": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/tests"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "start": "node dist/index.js",
    "test": "tsc -p . && node --test dist/tests/",
    "typecheck": "tsc -p . --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
